// Phantom menu (c) Ares. All rights reserved. Do not remove or change the "Made by Ares" credit.
// zm_zz_devmenu_veh - Phantom menu Vehicles: every vehicle stored in the game files that every
// mode loads (global_shared_mp, ingame_shared_mp, ingame_zm), set up with the game's own
// vehicle::generic_init and spawned with vehicle::spawn, so they work on any Zombies map.
// Most vehicle names are not public, so they are listed by number (generated by makeveh.js).
// Reached from the main menu with action "veh <action> [value]" (level.zm_dmv_run).

#using scripts\common\utility;
#using scripts\common\vehicle;

autoexec zm_dmv_init()
{
    // Zombies only: Kronos loads custom scripts in every mode
    if (!zm_dmv_init_is_zombies())
    {
        return;
    }
    level.zm_dmv_run = &zm_dmv_run;
    level.zm_dmv_refs = [];
    level.zm_dmv_zone = [];
    level.zm_dmv_name = [];
    level.zm_dmv_def = [];
    level.zm_dmv_refs[0] = %"vehiclebundle:veh_sat_blood_burner_ob";
    level.zm_dmv_def[0] = %"veh_sat_blood_burner";
    level.zm_dmv_zone[0] = "shared";
    level.zm_dmv_name[0] = "Blood Burner bike";
    level.zm_dmv_refs[1] = %"vehiclebundle:veh_t10_mil_us_heli_medium_trans_mp";
    level.zm_dmv_def[1] = %"veh_t10_mil_us_heli_medium_trans";
    level.zm_dmv_zone[1] = "shared";
    level.zm_dmv_name[1] = "Transport helicopter";
}

zm_dmv_run(a, v)
{
    if (a == "spawn")
    {
        return self zm_dmv_spawn(int(v));
    }
    if (a == "clear")
    {
        return "removed " + zm_dmv_clear() + " vehicles";
    }
    if (a == "test")
    {
        level thread zm_dmv_test(self, int(v));
        return "testing vehicles ...";
    }
    return "unknown vehicle action " + a;
}

zm_dmv_dbg(k, v)
{
    nengine_store_set("devmenu_dbg", k, v);
}

// set up vehicle i if the game has not; true when it has data
zm_dmv_setup(i)
{
    level.zm_dvs_r = level.zm_dmv_refs[i];
    if (!vehicle::has_data(level.zm_dvs_r))
    {
        vehicle::generic_init(level.zm_dvs_r);
    }
    if (!vehicle::has_data(level.zm_dvs_r) && isdefined(level.zm_dmv_def[i]))
    {
        // older vehicle data: set up by the vehicle name, spawn by it
        vehicle::generic_init(level.zm_dmv_def[i]);
        if (vehicle::has_data(level.zm_dmv_def[i]))
        {
            level.zm_dmv_refs[i] = level.zm_dmv_def[i];
        }
    }
    return vehicle::has_data(level.zm_dmv_refs[i]);
}

// self = player: vehicle i 250 units in front of you
zm_dmv_spawn(i)
{
    if (i < 0 || i >= level.zm_dmv_refs.size)
    {
        return "^1no vehicle " + i;
    }
    zm_dmv_dbg("veh_step", "setup " + (i + 1));
    nengine_store_save("devmenu_dbg", "state");
    if (!zm_dmv_setup(i))
    {
        return "^1vehicle " + (i + 1) + " can't be set up here";
    }
    self.zm_dmv_f = anglestoforward((0, self.angles[1], 0));
    self.zm_dmv_spot = { #origin:self.origin + self.zm_dmv_f * 250 + (0, 0, 20), #angles:(0, self.angles[1], 0) };
    zm_dmv_dbg("veh_step", "spawn " + (i + 1));
    nengine_store_save("devmenu_dbg", "state");
    self.zm_dmv_v = vehicle::spawn(level.zm_dmv_refs[i], self.zm_dmv_spot);
    if (!isdefined(self.zm_dmv_v))
    {
        return "^1vehicle " + (i + 1) + " did not spawn";
    }
    if (!isdefined(level.zm_dmv_made))
    {
        level.zm_dmv_made = [];
    }
    level.zm_dmv_made[level.zm_dmv_made.size] = self.zm_dmv_v;
    self.zm_dmv_m = "?";
    if (isdefined(self.zm_dmv_v.model))
    {
        self.zm_dmv_m = "" + self.zm_dmv_v.model;
    }
    zm_dmv_dbg("veh_last", (i + 1) + " ok model " + self.zm_dmv_m);
    return "vehicle " + (i + 1) + " spawned";
}

zm_dmv_clear()
{
    level.zm_dvc_n = 0;
    if (!isdefined(level.zm_dmv_made))
    {
        return 0;
    }
    for (level.zm_dvc_i = 0; level.zm_dvc_i < level.zm_dmv_made.size; level.zm_dvc_i++)
    {
        if (isdefined(level.zm_dmv_made[level.zm_dvc_i]))
        {
            level.zm_dmv_made[level.zm_dvc_i] delete();
            level.zm_dvc_n++;
        }
    }
    level.zm_dmv_made = [];
    return level.zm_dvc_n;
}

// debug: spawn + delete each vehicle from number "from" on; dbg veh_ok / veh_bad
// (if the game crashes, veh_step shows which one did it)
zm_dmv_test(p, from)
{
    level.zm_dvt_p = p;
    if (!isdefined(level.zm_dvt_ok) || from <= 0)
    {
        level.zm_dvt_ok = "";
        level.zm_dvt_bad = "";
    }
    if (from < 0)
    {
        from = 0;
    }
    for (level.zm_dvt_i = from; level.zm_dvt_i < level.zm_dmv_refs.size; level.zm_dvt_i++)
    {
        level.zm_dvt_msg = level.zm_dvt_p zm_dmv_spawn(level.zm_dvt_i);
        if (getsubstr(level.zm_dvt_msg, 0, 1) == "^")
        {
            level.zm_dvt_bad = level.zm_dvt_bad + (level.zm_dvt_i + 1) + " ";
        }
        else
        {
            level.zm_dvt_ok = level.zm_dvt_ok + (level.zm_dvt_i + 1) + " ";
        }
        zm_dmv_dbg("veh_ok", level.zm_dvt_ok);
        zm_dmv_dbg("veh_bad", level.zm_dvt_bad);
        nengine_store_save("devmenu_dbg", "state");
        wait 1.5;
        zm_dmv_clear();
        wait 0.3;
    }
    zm_dmv_dbg("veh_step", "test done");
    nengine_store_save("devmenu_dbg", "state");
}

// true in Zombies (game type zm_...), false in Multiplayer / other modes; unknown = allow
zm_dmv_init_is_zombies()
{
    level.zm_dmv_gt = getdvar(@"ui_gametype");
    if (!isdefined(level.zm_dmv_gt) || level.zm_dmv_gt == "")
    {
        return 1;
    }
    return getsubstr(level.zm_dmv_gt, 0, 2) == "zm";
}
