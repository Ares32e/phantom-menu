// true in Zombies (game type zm_...), false in Multiplayer / other modes; unknown = allow
zm_dm_anims_init_is_zombies()
{
    level.zm_dm_anims_init_gt = getdvar(@"ui_gametype");
    if (!isdefined(level.zm_dm_anims_init_gt) || level.zm_dm_anims_init_gt == "")
    {
        return 1;
    }
    return getsubstr(level.zm_dm_anims_init_gt, 0, 2) == "zm";
}
